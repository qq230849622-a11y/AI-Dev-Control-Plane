{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qq230849622-a11y/AI-Dev-Control-Plane/schemas/v1/result.schema.json",
  "title": "AICTRL Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "project_key",
    "repo",
    "task_id",
    "head_sha",
    "result_id",
    "actor",
    "status",
    "progress_delta",
    "summary",
    "evidence"
  ],
  "properties": {
    "protocol": {"const": "AICTRL_RESULT_V1"},
    "project_key": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "task_id": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "result_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "progress_delta": {
      "oneOf": [
        {"const": ["NONE"]},
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CODE_DELTA",
              "TEST_DELTA",
              "ERROR_DELTA",
              "EVIDENCE_DELTA",
              "EXTERNAL_STATE_DELTA",
              "ROOT_CAUSE_DELTA"
            ]
          }
        }
      ]
    },
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
