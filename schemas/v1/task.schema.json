{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qq230849622-a11y/AI-Dev-Control-Plane/schemas/v1/task.schema.json",
  "title": "AICTRL Task V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "project_key",
    "repo",
    "task_id",
    "head_sha",
    "objective",
    "outcome",
    "dependencies",
    "allowed_scope",
    "forbidden_scope",
    "acceptance_criteria",
    "complexity",
    "model",
    "reasoning",
    "goal_mode",
    "max_attempts",
    "testing_policy",
    "escalation_policy",
    "owner_gate_required",
    "status",
    "owner"
  ],
  "properties": {
    "protocol": {"const": "AICTRL_TASK_V1"},
    "project_key": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "task_id": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "objective": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "forbidden_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "complexity": {"enum": ["C0", "C1", "C2", "C3", "C4", "C5"]},
    "model": {"enum": ["luna", "terra", "sol"]},
    "reasoning": {"enum": ["low", "medium", "high"]},
    "goal_mode": {"type": "boolean"},
    "max_attempts": {"type": "integer", "minimum": 1},
    "testing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "commands"],
      "properties": {
        "required": {"type": "boolean"},
        "commands": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "escalation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_failure", "on_blocker"],
      "properties": {
        "on_failure": {"enum": ["STOP", "ESCALATE"]},
        "on_blocker": {"enum": ["STOP", "ESCALATE"]}
      }
    },
    "owner_gate_required": {"type": "boolean"},
    "status": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1}
  }
}
